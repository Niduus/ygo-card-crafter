<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CardCrafter.App.ViewModels"
             x:Class="CardCrafter.App.Views.ScriptView"
             x:DataType="vm:CardViewModel">
  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock VerticalAlignment="Center" IsVisible="{Binding UsesBlocks}" TextWrapping="Wrap"
                 Text="This script is written for you from the Effects tab. It updates as you edit." />
      <TextBlock VerticalAlignment="Center" IsVisible="{Binding UseCustomLua}" TextWrapping="Wrap"
                 Text="You are editing this card's script by hand. The Effects tab is not used." />
      <Button Content="Edit by hand…" Command="{Binding EjectToLuaCommand}" IsVisible="{Binding UsesBlocks}"
              ToolTip.Tip="Copy the generated script into an editor for things the blocks can't do yet" />
      <Button Content="Back to blocks" Command="{Binding BackToBlocksCommand}" IsVisible="{Binding UseCustomLua}" />
    </StackPanel>
    <TextBox Grid.Row="1" Text="{Binding Lua, Mode=OneWay}" IsReadOnly="True" IsVisible="{Binding UsesBlocks}"
             FontFamily="{StaticResource CodeFont}" FontSize="13" AcceptsReturn="True" TextWrapping="NoWrap" />
    <TextBox Grid.Row="1" Text="{Binding CustomLua}" IsVisible="{Binding UseCustomLua}"
             FontFamily="{StaticResource CodeFont}" FontSize="13" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" />
    <TextBlock Grid.Row="2" Classes="h2" Text="Checks" />
    <Border Grid.Row="3" Background="#16171C" CornerRadius="6" Padding="10" MaxHeight="180">
      <ScrollViewer>
        <StackPanel>
          <TextBlock Text="✔ No problems found. The script parses as Lua and only uses known engine functions."
                     IsVisible="{Binding NoProblems}" Foreground="#86EFAC" />
          <ItemsControl ItemsSource="{Binding Diagnostics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:DiagnosticItem">
                <TextBlock TextWrapping="Wrap" Margin="0,2">
                  <Run Text="{Binding Icon}" /><Run Text="  " /><Run Text="{Binding Text}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
