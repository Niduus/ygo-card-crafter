<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CardCrafter.App.ViewModels"
             xmlns:blocks="using:CardCrafter.Core.Blocks"
             x:Class="CardCrafter.App.Views.FilterEditorView"
             x:DataType="vm:FilterEditorViewModel"
             Width="396">
  <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
  <StackPanel Spacing="2">
    <TextBlock Text="Which cards?" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#C7D7FE" Margin="0,0,0,6" />
    <TextBlock Classes="label" Text="Which cards" IsVisible="{Binding AllowThatCard}" />
    <ComboBox Name="ThatBox" ItemsSource="{Binding ThatOptions}" SelectedItem="{Binding That}" IsVisible="{Binding AllowThatCard}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
              ToolTip.Tip="&quot;That card&quot;: cards the effect already has, as card text says &quot;destroy it&quot; or &quot;the sent monster&quot;. What you pick below is then only a check they must pass (&quot;if it is a Fusion Monster&quot;)." />
    <CheckBox Name="ThisCardBox" Content="This card itself" IsChecked="{Binding ThisCard}" IsVisible="{Binding ShowThisCard}" FontWeight="SemiBold" Margin="0,0,0,6"
              ToolTip.Tip="This exact card, wherever its effect is used from (&quot;Special Summon this card from your hand&quot;). A card name or passcode below means any copy." />
    <StackPanel IsEnabled="{Binding NotThisCard}">

    <TextBlock Classes="label" Text="Whose" IsVisible="{Binding ShowOwner}" />
    <ComboBox ItemsSource="{Binding OwnerOptions}" SelectedItem="{Binding Owner}" IsVisible="{Binding ShowOwner}" HorizontalAlignment="Stretch" />

    <TextBlock Classes="label" Text="Where" IsVisible="{Binding ShowWhere}" />
    <WrapPanel IsVisible="{Binding ShowWhere}">
      <CheckBox Content="Hand" IsChecked="{Binding InHand}" IsVisible="{Binding ShowHand}" Margin="0,0,10,0" />
      <CheckBox Content="Deck" IsChecked="{Binding InDeck}" IsVisible="{Binding ShowDeck}" Margin="0,0,10,0" />
      <CheckBox Content="Extra Deck" IsChecked="{Binding InExtra}" IsVisible="{Binding ShowExtra}" Margin="0,0,10,0" />
      <CheckBox Content="Monster Zone" IsChecked="{Binding InMonsterZone}" IsVisible="{Binding ShowMonsterZone}" Margin="0,0,10,0" />
      <CheckBox Content="Spell &amp; Trap Zone" IsChecked="{Binding InSpellTrapZone}" IsVisible="{Binding ShowSpellTrapZone}" Margin="0,0,10,0" />
      <CheckBox Content="Pendulum Zone" IsChecked="{Binding InPendulumZone}" IsVisible="{Binding ShowPendulumZone}" Margin="0,0,10,0" />
      <CheckBox Content="GY" IsChecked="{Binding InGraveyard}" IsVisible="{Binding ShowGraveyard}" Margin="0,0,10,0" />
      <CheckBox Content="Banished" IsChecked="{Binding InBanished}" IsVisible="{Binding ShowBanished}" Margin="0,0,10,0" />
    </WrapPanel>

    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <StackPanel Grid.Row="0" Grid.Column="0">
        <TextBlock Classes="label" Text="Card type" />
        <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding CardType}" HorizontalAlignment="Stretch" />
      </StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="2">
        <TextBlock Classes="label" Text="Monster kind" />
        <ComboBox Name="MonsterKindBox" ItemsSource="{Binding MonsterKindOptions}" SelectedItem="{Binding MonsterKind}" HorizontalAlignment="Stretch" MaxDropDownHeight="320"
                  ToolTip.Tip="Effect Monster, Tuner, non-Tuner, Link Monster... For example S:P Little Knight's &quot;2 Effect Monsters&quot;." />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="0">
        <TextBlock Classes="label" Text="Archetype" />
        <ComboBox ItemsSource="{Binding ArchetypeOptions}" SelectedItem="{Binding Archetype}" HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
        <ComboBox ItemsSource="{Binding ArchetypeOptions}" SelectedItem="{Binding Archetype2}" HorizontalAlignment="Stretch" MaxDropDownHeight="320" Margin="0,4,0,0"
                  ToolTip.Tip="Or this archetype: &quot;a &quot;Dominators&quot; or &quot;Dominus Purge&quot; Trap&quot;. Leave as &quot;Any archetype&quot; for none." />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="2">
        <TextBlock Classes="label" Text="Monster Type" />
        <ComboBox ItemsSource="{Binding RaceOptions}" SelectedItem="{Binding Race}" HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
        <TextBlock Classes="label" Text="Attribute (any of the ticked ones; none = any)" />
        <WrapPanel>
          <CheckBox Content="DARK" IsChecked="{Binding AttrDark}" Margin="0,0,8,0" MinWidth="0" />
          <CheckBox Content="LIGHT" IsChecked="{Binding AttrLight}" Margin="0,0,8,0" MinWidth="0" />
          <CheckBox Content="EARTH" IsChecked="{Binding AttrEarth}" Margin="0,0,8,0" MinWidth="0" />
          <CheckBox Content="WATER" IsChecked="{Binding AttrWater}" Margin="0,0,8,0" MinWidth="0" />
          <CheckBox Content="FIRE" IsChecked="{Binding AttrFire}" Margin="0,0,8,0" MinWidth="0" />
          <CheckBox Content="WIND" IsChecked="{Binding AttrWind}" Margin="0,0,8,0" MinWidth="0" />
          <CheckBox Content="DIVINE" IsChecked="{Binding AttrDivine}" Margin="0,0,8,0" MinWidth="0" />
        </WrapPanel>
      </StackPanel>
      <StackPanel Grid.Row="3" Grid.Column="0">
        <TextBlock Classes="label" Text="Level from / to" />
        <StackPanel Orientation="Horizontal" Spacing="4">
          <NumericUpDown Value="{Binding LevelMin}" Minimum="0" Maximum="13" FormatString="0" Width="84" ShowButtonSpinner="False" Watermark="any" />
          <NumericUpDown Value="{Binding LevelMax}" Minimum="0" Maximum="13" FormatString="0" Width="84" ShowButtonSpinner="False" Watermark="any" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="3" Grid.Column="2">
        <TextBlock Classes="label" Text="ATK from / to" />
        <StackPanel Orientation="Horizontal" Spacing="4">
          <NumericUpDown Value="{Binding AtkMin}" Minimum="0" Maximum="99999" Increment="100" FormatString="0" Width="84" ShowButtonSpinner="False" Watermark="any" />
          <NumericUpDown Value="{Binding AtkMax}" Minimum="0" Maximum="99999" Increment="100" FormatString="0" Width="84" ShowButtonSpinner="False" Watermark="any" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
        <TextBlock Classes="label" Text="Only this card (name or passcode)" />
        <AutoCompleteBox Text="{Binding CardCode}" ItemsSource="{Binding CardNameChoices}" Watermark="any card: type a name, e.g. Dark Magician"
                         FilterMode="Contains" MinimumPrefixLength="2" MaxDropDownHeight="260" HorizontalAlignment="Stretch"
                         ToolTip.Tip="Type part of a card's name and pick it, or type its passcode. Names come from this pack and from YGO Omega's card databases." />
      </StackPanel>
    </Grid>
    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0" IsVisible="{Binding !MaterialMode}">
      <StackPanel Grid.Row="0" Grid.Column="0">
        <TextBlock Classes="label" Text="Battle position" />
        <ComboBox ItemsSource="{Binding PositionOptions}" SelectedItem="{Binding Position}" HorizontalAlignment="Stretch" />
      </StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="2">
        <TextBlock Classes="label" Text="Spell/Trap kind" />
        <ComboBox ItemsSource="{Binding SpellTrapKindOptions}" SelectedItem="{Binding SpellTrapKind}" HorizontalAlignment="Stretch" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="0">
        <TextBlock Classes="label" Text="How it was Summoned" />
        <ComboBox ItemsSource="{Binding SummonedOptions}" SelectedItem="{Binding Summoned}" HorizontalAlignment="Stretch" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="2">
        <TextBlock Classes="label" Text="DEF from / to" />
        <StackPanel Orientation="Horizontal" Spacing="4">
          <NumericUpDown Value="{Binding DefMin}" Minimum="0" Maximum="99999" Increment="100" FormatString="0" Width="84" ShowButtonSpinner="False" Watermark="any" />
          <NumericUpDown Value="{Binding DefMax}" Minimum="0" Maximum="99999" Increment="100" FormatString="0" Width="84" ShowButtonSpinner="False" Watermark="any" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="0">
        <TextBlock Classes="label" Text="Or also named" />
        <AutoCompleteBox Text="{Binding AltCode}" ItemsSource="{Binding CardNameChoices}" Watermark="another name" FilterMode="Contains" MinimumPrefixLength="2" MaxDropDownHeight="260" HorizontalAlignment="Stretch"
                         ToolTip.Tip="&quot;Dark Magician&quot; or &quot;Dark Magician Girl&quot;: a second card it may be instead of the one above" />
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="2">
        <TextBlock Classes="label" Text="Mentions this card" />
        <AutoCompleteBox Text="{Binding MentionsCode}" ItemsSource="{Binding CardNameChoices}" Watermark="any" FilterMode="Contains" MinimumPrefixLength="2" MaxDropDownHeight="260" HorizontalAlignment="Stretch"
                         ToolTip.Tip="A card whose text mentions this card, like &quot;a Spell that mentions &quot;Dark Magician&quot;&quot;" />
        <CheckBox Content="or is that card" IsChecked="{Binding MentionsOrIs}" />
      </StackPanel>
    </Grid>
    <TextBlock Classes="label" Text="More requirements (all for the same card)" Margin="0,8,0,0" />
    <ItemsControl ItemsSource="{Binding Requirements}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:RequirementViewModel">
          <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,2">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,6,*,6,Auto">
                <ComboBox ItemsSource="{Binding PropertyOptions}" SelectedItem="{Binding Property}" HorizontalAlignment="Stretch" MaxDropDownHeight="360" ToolTip.Tip="What to check" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding OpOptions}" SelectedItem="{Binding Op}" HorizontalAlignment="Stretch" ToolTip.Tip="How it compares" />
                <Button Grid.Column="4" Classes="icon" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this requirement" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsNumber}">
                <NumericUpDown Value="{Binding Value}" Minimum="0" Maximum="999999" FormatString="0" Width="96" ShowButtonSpinner="False" />
                <TextBlock Text="and" VerticalAlignment="Center" IsVisible="{Binding IsRange}" />
                <NumericUpDown Value="{Binding Value2}" Minimum="0" Maximum="999999" FormatString="0" Width="96" ShowButtonSpinner="False" IsVisible="{Binding IsRange}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsCounter}">
                <ComboBox ItemsSource="{Binding CounterOptions}" SelectedItem="{Binding Counter}" MaxDropDownHeight="320" ToolTip.Tip="Which counter">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="blocks:ChoiceOption">
                      <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Text="{Binding CounterId}" Width="80" Watermark="0x1" IsVisible="{Binding IsCustomCounter}" ToolTip.Tip="The counter's id, in hexadecimal" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding IsChoices}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:RequirementChoice">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,0,8,0" MinWidth="0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ComboBox ItemsSource="{Binding ArchetypeOptions}" SelectedItem="{Binding Archetype}" IsVisible="{Binding IsArchetype}" HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
              <AutoCompleteBox Text="{Binding CardText}" ItemsSource="{Binding CardNameChoices}" IsVisible="{Binding IsCardName}" Watermark="type a card name"
                               FilterMode="Contains" MinimumPrefixLength="2" MaxDropDownHeight="260" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <CheckBox Content="Any one of these is enough (or)" IsChecked="{Binding AnyRequirement}" IsVisible="{Binding HasSeveralRequirements}"
              ToolTip.Tip="&quot;a DARK monster or a Dragon monster&quot;: the card needs to meet only one of the requirements above" />
    <Button Content="+ Add a requirement" Command="{Binding AddRequirementCommand}" HorizontalAlignment="Left"
            ToolTip.Tip="Original ATK, Rank, Link Rating, materials, counters, &quot;not DARK&quot;, how it was Summoned, whether its effects are negated..." />

    <Grid ColumnDefinitions="Auto,8,*" Margin="0,6,0,0">
      <CheckBox Content="except this card's name" IsChecked="{Binding ExceptOwnName}" VerticalAlignment="Center"
                ToolTip.Tip="Not a card with this card's name, e.g. &quot;1 Warrior monster from your Deck, except &quot;Card Name&quot;&quot;" />
      <TextBox Grid.Column="2" Text="{Binding ExceptCode}" Watermark="except (passcode)" />
    </Grid>
    <CheckBox Content="Face-up only" IsChecked="{Binding FaceUpOnly}" IsVisible="{Binding !MaterialMode}" Margin="0,6,0,0" />
    <CheckBox Content="Not revealed already (cards in the hand)" IsChecked="{Binding NotRevealed}" IsVisible="{Binding !MaterialMode}"
              ToolTip.Tip="For &quot;reveal 1 card in your hand&quot;: a card that isn't revealed already" />
    <CheckBox Content="Face-down only" IsChecked="{Binding FaceDownOnly}" IsVisible="{Binding !MaterialMode}"
              ToolTip.Tip="Only face-down cards, like &quot;face-down cards in your Spell &amp; Trap Zone&quot;" />
    <CheckBox Content="Not this card itself (&quot;other&quot;)" IsChecked="{Binding ExcludeThisCard}" IsVisible="{Binding !MaterialMode}" />
    <CheckBox IsChecked="{Binding PointedToByThisCard}" IsVisible="{Binding !MaterialMode}"
              ToolTip.Tip="Only cards in the zones this Link monster's Link Arrows point to">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Path Data="M12 3 L21 12 L16 12 L16 21 L8 21 L8 12 L3 12 Z" Fill="#F03A2E" Width="12" Height="12" Stretch="Uniform" />
        <TextBlock Text="Only cards this card points to (Link Arrows)" />
      </StackPanel>
    </CheckBox>
    <CheckBox Content="Only the monster in the center Main Monster Zone" IsChecked="{Binding CenterZone}" IsVisible="{Binding !MaterialMode}"
              ToolTip.Tip="Elfnote-style: the monster in the middle of the five Main Monster Zones" />
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</UserControl>
