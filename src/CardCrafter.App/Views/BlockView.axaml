<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CardCrafter.App.ViewModels"
             xmlns:blocks="using:CardCrafter.Core.Blocks"
             xmlns:views="using:CardCrafter.App.Views"
             x:Class="CardCrafter.App.Views.BlockView"
             x:DataType="vm:BlockViewModel">
  <StackPanel>
    <!-- connector to the action above: a short line with the link word in a pill -->
    <Grid IsVisible="{Binding ShowLink}" ColumnDefinitions="22,Auto,*" Height="30">
      <Rectangle Grid.Column="0" Width="2" Fill="#4D22C55E" HorizontalAlignment="Center" />
      <ComboBox Grid.Column="1" Classes="link" ItemsSource="{Binding LinkOptions}" SelectedItem="{Binding Link}"
                ToolTip.Tip="How this action connects to the one above it" />
    </Grid>
    <TextBlock Text="or" IsVisible="{Binding IsAlsoWhen}" FontWeight="SemiBold" Foreground="#C7D7FE" Margin="22,2,0,2"
               ToolTip.Tip="This trigger also starts the effect" />
    <Border x:Name="Row" Classes="block" ToolTip.Tip="{Binding Help}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Classes="kind" ToolTip.Tip="{Binding KindLabel}" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Segments}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:TextSegmentViewModel">
              <TextBlock Classes="sentence" Text="{Binding Text}" />
            </DataTemplate>
            <DataTemplate DataType="vm:IntSegmentViewModel">
              <NumericUpDown Classes="inline" Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                             Increment="{Binding Increment}" FormatString="0" Width="{Binding Width}" ShowButtonSpinner="False" ToolTip.Tip="{Binding Label}" IsVisible="{Binding IsShown}" />
            </DataTemplate>
            <DataTemplate DataType="vm:HexSegmentViewModel">
              <TextBox Classes="inline" Text="{Binding Text}" Width="72" Watermark="0x1" ToolTip.Tip="{Binding Label}" IsVisible="{Binding IsShown}" />
            </DataTemplate>
            <DataTemplate DataType="vm:ChoiceSegmentViewModel">
              <ComboBox Classes="inline" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" ToolTip.Tip="{Binding Label}" IsVisible="{Binding IsShown}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="blocks:ChoiceOption">
                    <TextBlock Text="{Binding Display}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </DataTemplate>
            <DataTemplate DataType="vm:BoolSegmentViewModel">
              <CheckBox Content="{Binding Label}" IsChecked="{Binding Value}" IsVisible="{Binding IsShown}" Margin="6,0" VerticalAlignment="Center" />
            </DataTemplate>
            <DataTemplate DataType="vm:CardsSegmentViewModel">
              <Button Classes="chip" Content="{Binding Summary}" ToolTip.Tip="Click to choose which cards" IsVisible="{Binding IsShown}">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <views:FilterEditorView DataContext="{Binding Editor}" />
                  </Flyout>
                </Button.Flyout>
              </Button>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Content="or the one above" IsChecked="{Binding Or}" IsVisible="{Binding ShowOr}" Margin="6,0"
                    ToolTip.Tip="This IF block or the one above it is enough (&quot;while you control a Dragon monster or your opponent controls a Spell&quot;)" />
          <CheckBox Content="you can" IsChecked="{Binding Optional}" IsVisible="{Binding ShowOptional}" Margin="6,0"
                    ToolTip.Tip="Optional: the player chooses whether this happens when the effect resolves (&quot;..., and if you do, you can Special Summon this card&quot;)" />
          <Button Classes="icon" Opacity="0.6" Content="↑" Command="{Binding MoveUpCommand}" IsVisible="{Binding !IsTrigger}" ToolTip.Tip="Move up" />
          <Button Classes="icon" Opacity="0.6" Content="↓" Command="{Binding MoveDownCommand}" IsVisible="{Binding !IsTrigger}" ToolTip.Tip="Move down" />
          <Button Classes="icon" Opacity="0.6" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this block" />
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
