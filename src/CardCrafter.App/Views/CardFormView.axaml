<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CardCrafter.App.ViewModels"
             xmlns:views="using:CardCrafter.App.Views"
             x:Class="CardCrafter.App.Views.CardFormView"
             x:DataType="vm:CardViewModel">
  <UserControl.Styles>
    <Style Selector="ToggleButton.arrow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="ToggleButton.arrow Path">
      <Setter Property="Data" Value="M 7,0 L 14,7 L 9.5,7 L 9.5,14 L 4.5,14 L 4.5,7 L 0,7 Z" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="#9CA3AF" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.arrow:checked Path">
      <Setter Property="Fill" Value="White" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <Grid ColumnDefinitions="*,24,300" Margin="0,0,12,12">
      <StackPanel Grid.Column="0">
        <!-- name on its own row, so it never gets squeezed in narrow windows -->
        <TextBlock Classes="label" Text="Card name" />
        <TextBox Text="{Binding Name}" />
        <Grid ColumnDefinitions="3*,12,2*" Margin="0,4,0,0">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="label" Text="Passcode (card ID)" />
            <Grid ColumnDefinitions="*,Auto">
              <NumericUpDown Value="{Binding Id}" Minimum="1" Maximum="4294967295" FormatString="0" ShowButtonSpinner="False"
                             ToolTip.Tip="The card's unique number. Click Generate and Card Crafter picks one nothing else uses." />
              <Button Grid.Column="1" Content="Generate" Command="{Binding GeneratePasscodeCommand}" Margin="4,0,0,0"
                      ToolTip.Tip="Pick a free passcode that no card in this pack or in Omega uses" />
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Card kind" />
            <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>

        <!-- YGO Omega's tags: its deck editor searches cards by card pool and limitation -->
        <Grid ColumnDefinitions="3*,12,2*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="label" Text="Card pool" />
            <ComboBox ItemsSource="{Binding CardPoolOptions}" SelectedItem="{Binding CardPoolChoice}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Where Omega's deck editor lists this card (Filter → Card Pool). Custom cards belong in Custom." />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Limitation" />
            <ComboBox ItemsSource="{Binding LimitationOptions}" SelectedItem="{Binding LimitationChoice}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Forbidden, Limited or Semi-Limited on every banlist in Omega (Filter → Limitation). Unlimited cards aren't on any banlist." />
          </StackPanel>
        </Grid>

        <!-- printed on the card face only -->
        <Grid ColumnDefinitions="3*,12,2*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="label" Text="Set number" />
            <TextBox Text="{Binding SetNumber}" Watermark="e.g. LDK2-ENY04" ToolTip.Tip="Printed under the art, right-aligned" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Edition" />
            <ComboBox ItemsSource="{Binding EditionOptions}" SelectedItem="{Binding Edition}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Printed after the passcode, like 1st Edition" />
          </StackPanel>
        </Grid>

        <Border IsVisible="{Binding HasPasscodeWarning}" Background="#3B2F12" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
          <TextBlock Text="{Binding PasscodeWarning}" TextWrapping="Wrap" Foreground="#FCD34D" />
        </Border>

        <!-- Monster -->
        <StackPanel IsVisible="{Binding IsMonster}">
          <Grid ColumnDefinitions="*,12,*,12,*">
            <StackPanel Grid.Column="0">
              <TextBlock Classes="label" Text="Frame" />
              <ComboBox ItemsSource="{Binding FrameOptions}" SelectedItem="{Binding Frame}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="Attribute" />
              <ComboBox ItemsSource="{Binding AttributeOptions}" SelectedItem="{Binding Attribute}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Classes="label" Text="Type" />
              <ComboBox ItemsSource="{Binding RaceOptions}" SelectedItem="{Binding Race}" HorizontalAlignment="Stretch" MaxDropDownHeight="360" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,12,*,12,*">
            <StackPanel Grid.Column="0" IsVisible="{Binding ShowLevel}">
              <TextBlock Classes="label" Text="{Binding LevelLabel}" />
              <NumericUpDown Value="{Binding Level}" Minimum="0" Maximum="13" FormatString="0" />
            </StackPanel>
            <StackPanel Grid.Column="0" IsVisible="{Binding IsLink}">
              <TextBlock Classes="label" Text="Link rating" />
              <!-- read-only, but the same height as the boxes next to it so the row lines up -->
              <Border Height="32" CornerRadius="4" Background="#1A1B22" BorderBrush="#2A2C36" BorderThickness="1" Padding="10,0"
                      ToolTip.Tip="Set by the number of Link Arrows">
                <TextBlock Text="{Binding LinkRatingText}" FontWeight="Bold" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="ATK" />
              <TextBox Text="{Binding Atk}" ToolTip.Tip="Type ? for an unknown ATK, like on official cards" />
            </StackPanel>
            <StackPanel Grid.Column="4" IsVisible="{Binding ShowDef}">
              <TextBlock Classes="label" Text="DEF" />
              <TextBox Text="{Binding Def}" ToolTip.Tip="Type ? for an unknown DEF, like on official cards" />
            </StackPanel>
          </Grid>

          <TextBlock Classes="label" Text="Abilities" />
          <WrapPanel>
            <CheckBox Content="Tuner" IsChecked="{Binding IsTuner}" Margin="0,0,14,0" />
            <CheckBox Content="Flip" IsChecked="{Binding IsFlip}" Margin="0,0,14,0" />
            <CheckBox Content="Pendulum" IsChecked="{Binding IsPendulumAbility}" Margin="0,0,14,0" />
            <CheckBox Content="Gemini" IsChecked="{Binding IsGemini}" Margin="0,0,14,0" />
            <CheckBox Content="Spirit" IsChecked="{Binding IsSpirit}" Margin="0,0,14,0" />
            <CheckBox Content="Toon" IsChecked="{Binding IsToon}" Margin="0,0,14,0" />
            <CheckBox Content="Union" IsChecked="{Binding IsUnion}" Margin="0,0,14,0" />
          </WrapPanel>

          <TextBlock Classes="label" Text="Summoning" />
          <ComboBox ItemsSource="{Binding SummonRuleOptions}" SelectedItem="{Binding SummonRuleChoice}" HorizontalAlignment="Stretch" />
          <TextBlock Text="{Binding SummonRuleHelp}" IsVisible="{Binding SummonRuleHelp, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,4,0,0" />

          <!-- same three columns as Level / ATK / DEF above, so the fields line up -->
          <Grid IsVisible="{Binding IsPendulum}" ColumnDefinitions="*,12,*,12,*">
            <StackPanel Grid.Column="0">
              <TextBlock Classes="label" Text="Left scale" />
              <NumericUpDown Value="{Binding LeftScale}" Minimum="0" Maximum="13" FormatString="0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="Right scale" />
              <NumericUpDown Value="{Binding RightScale}" Minimum="0" Maximum="13" FormatString="0" />
            </StackPanel>
          </Grid>

          <StackPanel IsVisible="{Binding IsLink}">
            <TextBlock Classes="label" Text="Link Arrows" />
            <!-- drawn arrows, rotated about their centre, so every one sits exactly in the middle of its button -->
            <Grid ColumnDefinitions="40,40,40" RowDefinitions="40,40,40" HorizontalAlignment="Left">
              <ToggleButton Classes="arrow" Grid.Row="0" Grid.Column="0" IsChecked="{Binding ArrowTopLeft}" ToolTip.Tip="Top left Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="-45" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="0" Grid.Column="1" IsChecked="{Binding ArrowTop}" ToolTip.Tip="Top Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="0" Grid.Column="2" IsChecked="{Binding ArrowTopRight}" ToolTip.Tip="Top right Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="45" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="1" Grid.Column="0" IsChecked="{Binding ArrowLeft}" ToolTip.Tip="Left Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="-90" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="1" Grid.Column="2" IsChecked="{Binding ArrowRight}" ToolTip.Tip="Right Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="90" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="2" Grid.Column="0" IsChecked="{Binding ArrowBottomLeft}" ToolTip.Tip="Bottom left Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="-135" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="2" Grid.Column="1" IsChecked="{Binding ArrowBottom}" ToolTip.Tip="Bottom Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="180" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="2" Grid.Column="2" IsChecked="{Binding ArrowBottomRight}" ToolTip.Tip="Bottom right Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="135" /></Path.RenderTransform></Path>
              </ToggleButton>
              <Border Grid.Row="1" Grid.Column="1" Margin="2" CornerRadius="4" Background="#22242C">
                <TextBlock Text="{Binding LinkRatingShort}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" />
              </Border>
            </Grid>
          </StackPanel>

          <!-- Extra Deck summoning -->
          <StackPanel IsVisible="{Binding IsExtraDeck}">
            <TextBlock Classes="h2" Text="{Binding ProcedureTitle}" />
            <StackPanel IsVisible="{Binding IsFusion}">
              <TextBlock Classes="label" Text="Exact materials by passcode (comma separated). Leave empty to use &quot;what a material must be&quot; below." />
              <TextBox Text="{Binding FusionCodes}" Watermark="e.g. 89631139, 46986414" />
            </StackPanel>
            <StackPanel IsVisible="{Binding IsSynchro}">
              <TextBlock Classes="label" Text="The Tuner must be" />
              <Button Classes="chip" Content="{Binding TunerFilter.Summary}">
                <Button.Flyout><Flyout><views:FilterEditorView DataContext="{Binding TunerFilter}" /></Flyout></Button.Flyout>
              </Button>
            </StackPanel>
            <StackPanel IsVisible="{Binding ShowMaterialFilter}">
              <TextBlock Classes="label" Text="Each material must be" />
              <Button Classes="chip" Content="{Binding MaterialFilter.Summary}">
                <Button.Flyout><Flyout><views:FilterEditorView DataContext="{Binding MaterialFilter}" /></Flyout></Button.Flyout>
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel>
                  <TextBlock Classes="label" Text="{Binding MinMaterialsLabel}" />
                  <NumericUpDown Value="{Binding MinMaterials}" Minimum="1" Maximum="10" FormatString="0" Width="120" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="label" Text="At most (0 = no limit)" />
                  <NumericUpDown Value="{Binding MaxMaterials}" Minimum="0" Maximum="10" FormatString="0" Width="120" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Spell / Trap -->
        <Grid IsVisible="{Binding IsSpell}" ColumnDefinitions="*,12,*,12,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="label" Text="Spell kind" />
            <ComboBox ItemsSource="{Binding SpellKindOptions}" SelectedItem="{Binding SpellKind}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>
        <Grid IsVisible="{Binding IsTrap}" ColumnDefinitions="*,12,*,12,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="label" Text="Trap kind" />
            <ComboBox ItemsSource="{Binding TrapKindOptions}" SelectedItem="{Binding TrapKind}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>

        <StackPanel IsVisible="{Binding HasArchetypes}">
          <TextBlock Classes="label" Text="Archetypes (add more on the left)" />
          <ItemsControl ItemsSource="{Binding ArchetypeChoices}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ArchetypeChoice">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,14,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Classes="h2" Text="Card text" />
        <StackPanel IsVisible="{Binding IsPendulum}">
          <TextBlock Classes="label" Text="Pendulum Effect" />
          <TextBox Text="{Binding PendulumText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
          <TextBlock Classes="label" Text="Monster Effect" />
        </StackPanel>
        <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" />
        <TextBlock Classes="label" Text="Suggested text from your effects" />
        <Border Background="#16171C" CornerRadius="6" Padding="10,6">
          <TextBlock Text="{Binding SuggestedText}" TextWrapping="Wrap" FontStyle="Italic" />
        </Border>
        <Button Content="Use suggested text" Command="{Binding UseSuggestedTextCommand}" Margin="0,6,0,0" />
      </StackPanel>

      <!-- Live card face and card art -->
      <StackPanel Grid.Column="2">
        <TextBlock Classes="label" Text="Preview" />
        <views:CardFace x:Name="Face" Width="300" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
          <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).FrameStatus}" FontSize="11"
                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
          <Button Content="Textures…" FontSize="11" Padding="8,2"
                  ToolTip.Tip="Choose the card textures the preview is assembled from">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Use card textures from a .zip…" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ChooseTextureZipCommand}"
                          ToolTip.Tip="A zip of card textures (frames, Attributes, stars, Link Arrows, icons) and optional fonts. It is unpacked into your AppData folder." />
                <MenuItem Header="Use card textures from a folder…" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ChooseFrameFolderCommand}" />
                <MenuItem Header="Stop using card textures" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ClearTexturesCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).FontStatus}" FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" MaxWidth="300" HorizontalAlignment="Left" />
        <Button Content="Save image…" Margin="0,6,0,0" HorizontalAlignment="Left" ToolTip.Tip="Save this preview as a PNG or JPG at any size">
          <Button.Flyout>
            <Flyout Placement="LeftEdgeAlignedTop">
              <StackPanel Width="280" Spacing="6">
                <TextBlock Text="Save the card preview as an image" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).ImageSizes}"
                          SelectedItem="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectedImageSize}" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsCustomImageSize}">
                  <TextBlock Text="Width (px)" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding $parent[Window].((vm:MainViewModel)DataContext).CustomImageWidth}" Minimum="64" Maximum="8000"
                                 Increment="50" FormatString="0" Width="130" />
                </StackPanel>
                <TextBlock Text="The height follows the card's shape. Type .jpg as the file name ending for JPG." FontSize="11"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                <Button Content="Save this card…" HorizontalAlignment="Stretch" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SaveCardImageCommand}" />
                <Button Content="Save every card in the pack…" HorizontalAlignment="Stretch" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SaveAllCardImagesCommand}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBlock Classes="label" Text="Card art: the picture inside the frame" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Choose art…" Click="OnPickArtwork" />
          <Button Content="Remove" Click="OnRemoveArtwork" IsVisible="{Binding HasArtwork}" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" Width="300" HorizontalAlignment="Left"
                   Text="Use just the illustration, not a whole card. Square images fit best; YGO Omega draws the frame itself and keeps art as .jpg in its Arts folder." />
        <TextBlock Text="{Binding ArtworkPath}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" Width="300" HorizontalAlignment="Left" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
