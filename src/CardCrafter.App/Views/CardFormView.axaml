<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CardCrafter.App.ViewModels"
             xmlns:views="using:CardCrafter.App.Views"
             x:Class="CardCrafter.App.Views.CardFormView"
             x:DataType="vm:CardViewModel">
  <UserControl.Styles>
    <Style Selector="ToggleButton.arrow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="ToggleButton.arrow Path">
      <Setter Property="Data" Value="M 7,0 L 14,7 L 9.5,7 L 9.5,14 L 4.5,14 L 4.5,7 L 0,7 Z" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="#9CA3AF" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.arrow:checked Path">
      <Setter Property="Fill" Value="White" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <Grid ColumnDefinitions="*,24,300" Margin="0,0,12,12">
      <StackPanel Grid.Column="0">
        <!-- name on its own row, so it never gets squeezed in narrow windows -->
        <TextBlock Classes="label" Text="Card name" />
        <TextBox Text="{Binding Name}" />
        <Grid ColumnDefinitions="3*,12,2*" Margin="0,4,0,0">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="label" Text="Passcode (card ID)" />
            <Grid ColumnDefinitions="*,Auto">
              <NumericUpDown Value="{Binding Id}" Minimum="1" Maximum="4294967295" FormatString="0" ShowButtonSpinner="False"
                             ToolTip.Tip="The card's unique number. Click Generate and Card Crafter picks one nothing else uses." />
              <Button Grid.Column="1" Content="Generate" Command="{Binding GeneratePasscodeCommand}" Margin="4,0,0,0"
                      ToolTip.Tip="Pick a free passcode that no card in this pack or in Omega uses" />
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Card kind" />
            <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>

        <!-- YGO Omega's tags: its deck editor searches cards by card pool and limitation -->
        <Grid ColumnDefinitions="3*,12,2*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="label" Text="Card pool" />
            <ComboBox ItemsSource="{Binding CardPoolOptions}" SelectedItem="{Binding CardPoolChoice}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Where Omega's deck editor lists this card (Filter → Card Pool). Custom cards belong in Custom." />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Limitation" />
            <ComboBox ItemsSource="{Binding LimitationOptions}" SelectedItem="{Binding LimitationChoice}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Forbidden, Limited or Semi-Limited on every banlist in Omega (Filter → Limitation). Unlimited cards aren't on any banlist." />
          </StackPanel>
        </Grid>

        <!-- printed on the card face only -->
        <Grid ColumnDefinitions="3*,12,2*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="label" Text="Set number" />
            <TextBox Text="{Binding SetNumber}" Watermark="e.g. LDK2-ENY04" ToolTip.Tip="Printed under the art, right-aligned" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Edition" />
            <ComboBox ItemsSource="{Binding EditionOptions}" SelectedItem="{Binding Edition}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Printed after the passcode, like 1st Edition" />
          </StackPanel>
        </Grid>

        <Expander Header="Codes: passcode, Type, Attribute, archetypes" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                  ToolTip.Tip="The numbers this card is stored with, as databases and scripts use them">
          <StackPanel Spacing="2">
            <ItemsControl ItemsSource="{Binding Codes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:CodeRowViewModel">
                  <Grid ColumnDefinitions="110,Auto,*,Auto" Margin="0,1">
                    <TextBlock Text="{Binding Label}" Opacity="0.7" VerticalAlignment="Center" FontSize="12" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Note}" IsVisible="{Binding HasNote}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="3" Content="{Binding CopyLabel}" Command="{Binding CopyCommand}" Padding="8,2" FontSize="12" ToolTip.Tip="Copy this code" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Copy all codes" Command="{Binding CopyAllCodesCommand}" HorizontalAlignment="Left" Padding="8,2" FontSize="12" Margin="0,2,0,0" />
          </StackPanel>
        </Expander>

        <Expander Header="{Binding StringsHeader}" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                  ToolTip.Tip="The database's str1–str16, as DataEditorX shows them: the text the game shows for each effect when it lists effects to activate and when it asks a &quot;you can&quot; question. Each starts as the effect's own text; type to change it.">
          <StackPanel Spacing="4">
            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                       Text="When your card's effect is the only one that can be activated, the game's engine asks &quot;activate [card] from [Hand]?&quot; without any effect text, for official cards too. These strings show up wherever the game does use the effect's description: the list of effects to activate, &quot;you can&quot; questions and option choices." />
            <ItemsControl ItemsSource="{Binding Strings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:StringRowViewModel">
                  <Grid ColumnDefinitions="44,*,Auto" RowDefinitions="Auto,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Label}" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" VerticalAlignment="Top" Margin="0,6,0,0" ToolTip.Tip="{Binding Lua}" />
                    <TextBox Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" AcceptsReturn="False" Watermark="{Binding Generated}" />
                    <Button Grid.Column="2" Content="Reset" Command="{Binding ResetCommand}" IsVisible="{Binding IsOverridden}" Padding="8,2" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Top"
                            ToolTip.Tip="Go back to the effect's own text" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Use}" Opacity="0.6" FontSize="11" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>

        <Border IsVisible="{Binding HasPasscodeWarning}" Background="#3B2F12" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding PasscodeWarning}" TextWrapping="Wrap" Foreground="#FCD34D" />
            <Button Content="Fix all passcodes in this pack" Command="{Binding FixPasscodesCommand}" IsVisible="{Binding IsPasscodeTooLarge}"
                    HorizontalAlignment="Left" Padding="8,2" FontSize="12"
                    ToolTip.Tip="Gives every card whose passcode is too large one that fits, and updates the cards that name them" />
          </StackPanel>
        </Border>

        <CheckBox Content="You can only control 1 of this card" IsChecked="{Binding OnlyOneOnField}" Margin="0,8,0,0"
                  ToolTip.Tip="&quot;You can only control 1 &quot;Card Name&quot;.&quot;" />

        <!-- Monster -->
        <StackPanel IsVisible="{Binding IsMonster}">
          <Grid ColumnDefinitions="*,12,*,12,*">
            <StackPanel Grid.Column="0">
              <TextBlock Classes="label" Text="Frame" />
              <ComboBox ItemsSource="{Binding FrameOptions}" SelectedItem="{Binding Frame}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="Attribute" />
              <ComboBox ItemsSource="{Binding AttributeOptions}" SelectedItem="{Binding Attribute}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Classes="label" Text="Type" />
              <ComboBox ItemsSource="{Binding RaceOptions}" SelectedItem="{Binding Race}" HorizontalAlignment="Stretch" MaxDropDownHeight="360" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,12,*,12,*">
            <StackPanel Grid.Column="0" IsVisible="{Binding ShowLevel}">
              <TextBlock Classes="label" Text="{Binding LevelLabel}" />
              <NumericUpDown Value="{Binding Level}" Minimum="0" Maximum="13" FormatString="0" />
            </StackPanel>
            <StackPanel Grid.Column="0" IsVisible="{Binding IsLink}">
              <TextBlock Classes="label" Text="Link rating" />
              <!-- read-only, but the same height as the boxes next to it so the row lines up -->
              <Border Height="32" CornerRadius="4" Background="#1A1B22" BorderBrush="#2A2C36" BorderThickness="1" Padding="10,0"
                      ToolTip.Tip="Set by the number of Link Arrows">
                <TextBlock Text="{Binding LinkRatingText}" FontWeight="Bold" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="ATK" />
              <TextBox Text="{Binding Atk}" ToolTip.Tip="Type ? for an unknown ATK, like on official cards" />
            </StackPanel>
            <StackPanel Grid.Column="4" IsVisible="{Binding ShowDef}">
              <TextBlock Classes="label" Text="DEF" />
              <TextBox Text="{Binding Def}" ToolTip.Tip="Type ? for an unknown DEF, like on official cards" />
            </StackPanel>
          </Grid>

          <TextBlock Classes="label" Text="Abilities" />
          <WrapPanel>
            <CheckBox Content="Tuner" IsChecked="{Binding IsTuner}" Margin="0,0,14,0" />
            <CheckBox Content="Flip" IsChecked="{Binding IsFlip}" Margin="0,0,14,0" />
            <CheckBox Content="Pendulum" IsChecked="{Binding IsPendulumAbility}" Margin="0,0,14,0" />
            <CheckBox Content="Gemini" IsChecked="{Binding IsGemini}" Margin="0,0,14,0" />
            <CheckBox Content="Spirit" IsChecked="{Binding IsSpirit}" Margin="0,0,14,0" />
            <CheckBox Content="Toon" IsChecked="{Binding IsToon}" Margin="0,0,14,0" />
            <CheckBox Content="Union" IsChecked="{Binding IsUnion}" Margin="0,0,14,0" />
          </WrapPanel>

          <TextBlock Classes="label" Text="Summoning" />
          <Grid ColumnDefinitions="*,12,Auto">
            <ComboBox ItemsSource="{Binding SummonRuleOptions}" SelectedItem="{Binding SummonRuleChoice}" HorizontalAlignment="Stretch" />
            <CheckBox Grid.Column="2" Content="Cannot be Special Summoned" IsChecked="{Binding CannotBeSpecialSummoned}" VerticalAlignment="Center"
                      ToolTip.Tip="&quot;Cannot be Special Summoned.&quot;, like the Egyptian Gods" />
          </Grid>
          <TextBlock Text="{Binding SummonRuleHelp}" IsVisible="{Binding SummonRuleHelp, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,4,0,0" />
          <CheckBox Content="Can only be Special Summoned once per turn" IsChecked="{Binding SpecialSummonOncePerTurn}" Margin="0,4,0,0"
                    ToolTip.Tip="&quot;You can only Special Summon &quot;Card Name&quot; once per turn.&quot;" />

          <!-- same three columns as Level / ATK / DEF above, so the fields line up -->
          <Grid IsVisible="{Binding IsPendulum}" ColumnDefinitions="*,12,*,12,*">
            <StackPanel Grid.Column="0">
              <TextBlock Classes="label" Text="Left scale" />
              <NumericUpDown Value="{Binding LeftScale}" Minimum="0" Maximum="13" FormatString="0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="Right scale" />
              <NumericUpDown Value="{Binding RightScale}" Minimum="0" Maximum="13" FormatString="0" />
            </StackPanel>
          </Grid>

          <StackPanel IsVisible="{Binding IsLink}">
            <TextBlock Classes="label" Text="Link Arrows" />
            <!-- drawn arrows, rotated about their centre, so every one sits exactly in the middle of its button -->
            <Grid ColumnDefinitions="40,40,40" RowDefinitions="40,40,40" HorizontalAlignment="Left">
              <ToggleButton Classes="arrow" Grid.Row="0" Grid.Column="0" IsChecked="{Binding ArrowTopLeft}" ToolTip.Tip="Top left Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="-45" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="0" Grid.Column="1" IsChecked="{Binding ArrowTop}" ToolTip.Tip="Top Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="0" Grid.Column="2" IsChecked="{Binding ArrowTopRight}" ToolTip.Tip="Top right Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="45" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="1" Grid.Column="0" IsChecked="{Binding ArrowLeft}" ToolTip.Tip="Left Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="-90" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="1" Grid.Column="2" IsChecked="{Binding ArrowRight}" ToolTip.Tip="Right Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="90" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="2" Grid.Column="0" IsChecked="{Binding ArrowBottomLeft}" ToolTip.Tip="Bottom left Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="-135" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="2" Grid.Column="1" IsChecked="{Binding ArrowBottom}" ToolTip.Tip="Bottom Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="180" /></Path.RenderTransform></Path>
              </ToggleButton>
              <ToggleButton Classes="arrow" Grid.Row="2" Grid.Column="2" IsChecked="{Binding ArrowBottomRight}" ToolTip.Tip="Bottom right Link Arrow">
                <Path><Path.RenderTransform><RotateTransform Angle="135" /></Path.RenderTransform></Path>
              </ToggleButton>
              <Border Grid.Row="1" Grid.Column="1" Margin="2" CornerRadius="4" Background="#22242C">
                <TextBlock Text="{Binding LinkRatingShort}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" />
              </Border>
            </Grid>
          </StackPanel>

          <!-- Summoning conditions: the materials of Extra Deck monsters -->
          <StackPanel IsVisible="{Binding IsExtraDeck}" Spacing="6">
            <TextBlock Classes="h2" Text="Summoning conditions" />
            <TextBlock Classes="label" TextWrapping="Wrap"
                       Text="What this card needs to be Summoned from the Extra Deck. Other ways to Summon it (like TY-PHON's) are effects: add them on the Effects tab." />
            <Border Name="MaterialsPreview" IsVisible="{Binding HasMaterialsText}" Background="#1A1B22" CornerRadius="6" Padding="10,6" BorderBrush="#2A2C36" BorderThickness="1">
              <StackPanel>
                <TextBlock Classes="label" Text="Printed first on the card" />
                <TextBlock Text="{Binding MaterialsText}" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- Fusion: materials one by one -->
            <StackPanel IsVisible="{Binding IsFusion}" Spacing="4">
              <Grid ColumnDefinitions="40,*,80,80,40" Margin="0,4,0,0">
                <TextBlock Grid.Column="1" Classes="label" Text="Material (a card, or what it must be)" />
                <TextBlock Grid.Column="2" Classes="label" Text="At least" Margin="8,0,0,0" />
                <TextBlock Grid.Column="3" Classes="label" Text="At most" Margin="8,0,0,0" ToolTip.Tip="0 means &quot;or more&quot;" />
              </Grid>
              <ItemsControl Name="FusionSlotList" ItemsSource="{Binding FusionSlots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:MaterialSlotViewModel">
                    <Grid ColumnDefinitions="40,*,80,80,40" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
                      <TextBlock Text="{Binding Count}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" />
                      <Button Grid.Column="1" Classes="chip" Content="{Binding Summary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Center">
                        <Button.Flyout><Flyout><views:FilterEditorView DataContext="{Binding Filter}" /></Flyout></Button.Flyout>
                      </Button>
                      <NumericUpDown Grid.Column="2" Value="{Binding Min}" Minimum="1" Maximum="10" FormatString="0" Margin="8,0,0,0"
                                     ShowButtonSpinner="False" HorizontalContentAlignment="Center" />
                      <NumericUpDown Grid.Column="3" Value="{Binding Max}" Minimum="0" Maximum="10" FormatString="0" Margin="8,0,0,0"
                                     ShowButtonSpinner="False" HorizontalContentAlignment="Center" ToolTip.Tip="0 means &quot;or more&quot;" />
                      <Button Grid.Column="4" Content="✕" Command="{Binding RemoveCommand}" Margin="8,0,0,0" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center" VerticalAlignment="Stretch" ToolTip.Tip="Remove this material" />
                      <!-- "Red-Eyes Black Dragon" or 1 Dragon Effect Monster -->
                      <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <Button Classes="chip" Content="{Binding OrSummary}" IsVisible="{Binding HasOr}">
                          <Button.Flyout><Flyout><views:FilterEditorView DataContext="{Binding OrFilter}" /></Flyout></Button.Flyout>
                        </Button>
                        <Button Content="✕" Command="{Binding RemoveOrCommand}" IsVisible="{Binding HasOr}" Padding="6,0" ToolTip.Tip="Remove the &quot;or&quot;" />
                        <Button Content="+ or another kind" Command="{Binding AddOrCommand}" IsVisible="{Binding !HasOr}" Padding="8,2" FontSize="12"
                                ToolTip.Tip="Let this material be another kind of card too, like Dragoon's &quot;Red-Eyes Black Dragon&quot; or 1 Dragon Effect Monster" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Name="AddFusionSlotButton" Content="+ Add a material" Command="{Binding AddFusionSlotCommand}" />
              <TextBlock Classes="label" TextWrapping="Wrap"
                         Text="For a specific card, enter its passcode in &quot;Only this card&quot;. One material may take more than 1 card (e.g. at most 0 = &quot;1+ Fiend monsters&quot;)." />
              <!-- Contact Fusion: "Must first be Special Summoned (from your Extra Deck) by shuffling the above cards you control into the Deck." -->
              <StackPanel Spacing="4" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox Name="ContactBox" Content="Contact Fusion: Special Summoned from the Extra Deck with the materials above you control, by" IsChecked="{Binding Contact}"
                            VerticalAlignment="Center" ToolTip.Tip="Like Elemental HERO Neos's Contact Fusions and Gladiator Beasts: you do not use &quot;Polymerization&quot;." />
                  <ComboBox ItemsSource="{Binding ContactMoveOptions}" SelectedItem="{Binding ContactMoveChoice}" IsEnabled="{Binding Contact}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel IsVisible="{Binding Contact}" Spacing="4" Margin="24,0,0,0">
                  <WrapPanel Orientation="Horizontal">
                    <CheckBox Content="Spell &amp; Trap Zones too" IsChecked="{Binding ContactWholeField}" Margin="0,0,12,0" />
                    <CheckBox Content="also from the hand" IsChecked="{Binding ContactFromHand}" Margin="0,0,12,0" />
                    <CheckBox Content="also from the GY" IsChecked="{Binding ContactFromGrave}" Margin="0,0,12,0" />
                    <CheckBox Content="the opponent's cards too" IsChecked="{Binding ContactOpponent}" />
                  </WrapPanel>
                  <ComboBox ItemsSource="{Binding ContactRuleOptions}" SelectedItem="{Binding ContactRuleChoice}" HorizontalAlignment="Stretch" />
                  <TextBlock Text="{Binding ContactText}" TextWrapping="Wrap" FontStyle="Italic" />
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- Synchro: the Tuner -->
            <StackPanel IsVisible="{Binding IsSynchro}">
              <TextBlock Classes="label" Text="1 Tuner, which must be" />
              <Button Classes="chip" Content="{Binding TunerFilter.Summary}">
                <Button.Flyout><Flyout><views:FilterEditorView DataContext="{Binding TunerFilter}" /></Flyout></Button.Flyout>
              </Button>
            </StackPanel>

            <!-- Synchro non-Tuners, Xyz and Link materials -->
            <StackPanel IsVisible="{Binding ShowMaterialFilter}" Spacing="4">
              <TextBlock Classes="label" Text="Each material must be" />
              <Button Classes="chip" Content="{Binding MaterialFilter.Summary}">
                <Button.Flyout><Flyout><views:FilterEditorView DataContext="{Binding MaterialFilter}" /></Flyout></Button.Flyout>
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel>
                  <TextBlock Classes="label" Text="{Binding MinMaterialsLabel}" />
                  <NumericUpDown Value="{Binding MinMaterials}" Minimum="1" Maximum="10" FormatString="0" Width="120" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="label" Text="At most (0 = no limit)" />
                  <NumericUpDown Value="{Binding MaxMaterials}" Minimum="0" Maximum="10" FormatString="0" Width="120" />
                </StackPanel>
                <StackPanel IsVisible="{Binding IsXyz}">
                  <TextBlock Classes="label" Text="Their Level (0 = the Rank)" />
                  <NumericUpDown Name="XyzLevelBox" Value="{Binding XyzMaterialLevel}" Minimum="0" Maximum="13" FormatString="0" Width="120" />
                </StackPanel>
              </StackPanel>
              <!-- "You can also Xyz Summon this card by using 1 Xyz Monster you control" (Number C39, Sky Thunder) -->
              <StackPanel IsVisible="{Binding IsXyz}" Spacing="4" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox Name="XyzAlternateBox" Content="Can also be Xyz Summoned by using 1" IsChecked="{Binding XyzAlternate}" VerticalAlignment="Center"
                            ToolTip.Tip="Put this card on top of a monster you control instead of using materials; that monster's materials go to this card." />
                  <Button Classes="chip" Content="{Binding XyzAlternateFilter.Summary}" IsEnabled="{Binding XyzAlternate}" VerticalAlignment="Center">
                    <Button.Flyout><Flyout><views:FilterEditorView DataContext="{Binding XyzAlternateFilter}" /></Flyout></Button.Flyout>
                  </Button>
                  <TextBlock Text="you control" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel IsVisible="{Binding XyzAlternate}" Orientation="Horizontal" Margin="24,0,0,0">
                  <CheckBox Content="once per turn" IsChecked="{Binding XyzAlternateOncePerTurn}" Margin="0,0,12,0" />
                  <CheckBox Content="only if an Xyz Monster battled this turn" IsChecked="{Binding XyzAlternateAfterXyzBattle}" Margin="0,0,12,0" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="detaching" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding XyzAlternateDetach}" Minimum="0" Maximum="5" FormatString="0" Width="110" />
                    <TextBlock Text="of its materials" VerticalAlignment="Center" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsLinkProcedure}" Orientation="Horizontal" Spacing="8">
                <CheckBox Name="LinkIncludingBox" Content="including a" IsChecked="{Binding Including}" VerticalAlignment="Center" />
                <Button Classes="chip" Content="{Binding IncludeFilter.Summary}" IsEnabled="{Binding Including}" VerticalAlignment="Center">
                  <Button.Flyout><Flyout><views:FilterEditorView DataContext="{Binding IncludeFilter}" /></Flyout></Button.Flyout>
                </Button>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Spell / Trap -->
        <Grid IsVisible="{Binding IsSpell}" ColumnDefinitions="*,12,2*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="label" Text="Spell kind" />
            <ComboBox ItemsSource="{Binding SpellKindOptions}" SelectedItem="{Binding SpellKind}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="2" IsVisible="{Binding IsEquipSpell}">
            <TextBlock Classes="label" Text="Equip to" />
            <Button Name="EquipFilterButton" Classes="chip" Content="{Binding EquipFilter.Summary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    ToolTip.Tip="The monsters this card can be equipped to. What it gives them: Effects tab, &quot;While face-up&quot; with &quot;The equipped monster ...&quot;.">
              <Button.Flyout><Flyout><views:FilterEditorView DataContext="{Binding EquipFilter}" /></Flyout></Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
        <Grid IsVisible="{Binding IsTrap}" ColumnDefinitions="*,12,*,12,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="label" Text="Trap kind" />
            <ComboBox ItemsSource="{Binding TrapKindOptions}" SelectedItem="{Binding TrapKind}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>

        <StackPanel IsVisible="{Binding HasArchetypes}">
          <TextBlock Classes="label" Text="Archetypes (add more on the left)" />
          <ItemsControl ItemsSource="{Binding ArchetypeChoices}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ArchetypeChoice">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,14,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox Name="ArchetypeReminderBox" Content="Say &quot;(This card is always treated as a &quot;X&quot; card.)&quot; when the name doesn't" IsChecked="{Binding ArchetypeReminder}"
                    ToolTip.Tip="Official cards print this line first for each archetype whose name isn't in the card's name. The suggested text has it; untick it for a card whose name says the archetype another way." />
        </StackPanel>

        <TextBlock Classes="h2" Text="Card text" />
        <StackPanel IsVisible="{Binding IsPendulum}">
          <TextBlock Classes="label" Text="Pendulum Effect" />
          <TextBox Text="{Binding PendulumText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
          <TextBlock Classes="label" Text="Monster Effect" />
        </StackPanel>
        <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" />
        <Border IsVisible="{Binding HasArchetypeReminderNote}" Background="#1B2433" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ArchetypeReminderNote}" TextWrapping="Wrap" Foreground="#BFDBFE" />
            <Button Name="AddArchetypeReminderButton" Content="Add the archetype line" Command="{Binding AddArchetypeReminderCommand}"
                    HorizontalAlignment="Left" Padding="8,2" FontSize="12"
                    ToolTip.Tip="Puts the line where official cards print it: first, after an Extra Deck monster's materials, or after a Normal Monster's flavor text" />
          </StackPanel>
        </Border>
        <TextBlock Classes="label" Text="Suggested text from your effects" />
        <Border Background="#16171C" CornerRadius="6" Padding="10,6" IsVisible="{Binding IsPendulum}" Margin="0,0,0,4">
          <StackPanel>
            <TextBlock Text="[ Pendulum Effect ]" FontStyle="Italic" />
            <TextBlock Text="{Binding SuggestedPendulumText}" TextWrapping="Wrap" FontStyle="Italic" />
            <TextBlock Text="[ Monster Effect ]" FontStyle="Italic" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <Border Background="#16171C" CornerRadius="6" Padding="10,6">
          <TextBlock Text="{Binding SuggestedText}" TextWrapping="Wrap" FontStyle="Italic" />
        </Border>
        <Button Content="Use suggested text" Command="{Binding UseSuggestedTextCommand}" Margin="0,6,0,0" />
      </StackPanel>

      <!-- Live card face and card art -->
      <StackPanel Grid.Column="2">
        <TextBlock Classes="label" Text="Preview" />
        <views:CardFace x:Name="Face" Width="300" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
          <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).FrameStatus}" FontSize="11"
                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
          <Button Content="Textures…" FontSize="11" Padding="8,2"
                  ToolTip.Tip="Choose the card textures the preview is assembled from">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Use card textures from a .zip…" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ChooseTextureZipCommand}"
                          ToolTip.Tip="A zip of card textures (frames, Attributes, stars, Link Arrows, icons) and optional fonts. It is unpacked into your AppData folder." />
                <MenuItem Header="Use card textures from a folder…" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ChooseFrameFolderCommand}" />
                <MenuItem Header="Stop using card textures" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ClearTexturesCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).FontStatus}" FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" MaxWidth="300" HorizontalAlignment="Left" />
        <Button Content="Save image…" Margin="0,6,0,0" HorizontalAlignment="Left" ToolTip.Tip="Save this preview as a PNG or JPG at any size">
          <Button.Flyout>
            <Flyout Placement="LeftEdgeAlignedTop">
              <StackPanel Width="280" Spacing="6">
                <TextBlock Text="Save the card preview as an image" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).ImageSizes}"
                          SelectedItem="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectedImageSize}" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsCustomImageSize}">
                  <TextBlock Text="Width (px)" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding $parent[Window].((vm:MainViewModel)DataContext).CustomImageWidth}" Minimum="64" Maximum="8000"
                                 Increment="50" FormatString="0" Width="130" />
                </StackPanel>
                <TextBlock Text="The height follows the card's shape. Type .jpg as the file name ending for JPG." FontSize="11"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                <Button Content="Save this card…" HorizontalAlignment="Stretch" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SaveCardImageCommand}" />
                <Button Content="Save every card in the pack…" HorizontalAlignment="Stretch" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SaveAllCardImagesCommand}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBlock Classes="label" Text="Card art: the picture inside the frame" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Choose art…" Click="OnPickArtwork" />
          <Button Content="Remove" Click="OnRemoveArtwork" IsVisible="{Binding HasArtwork}" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" Width="300" HorizontalAlignment="Left"
                   Text="Use just the illustration, not a whole card. Square images fit best; YGO Omega draws the frame itself and keeps art as .jpg in its Arts folder." />
        <TextBlock Text="{Binding ArtworkPath}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" Width="300" HorizontalAlignment="Left" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
