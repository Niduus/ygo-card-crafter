<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CardCrafter.App.ViewModels"
             xmlns:views="using:CardCrafter.App.Views"
             x:Class="CardCrafter.App.Views.EffectSheetView"
             x:DataType="vm:CardViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="+ New effect" Command="{Binding AddEffectCommand}" />
        <Button Content="+ From a template…" Click="OnTemplates"
                ToolTip.Tip="Start from an effect modelled on a well-known card, then change any part of it" />
        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   Text="Each effect reads left to right: WHEN it starts and IF it's allowed, then the COST and what it DOes." />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" IsVisible="{Binding UseCustomLua}" Background="#3B2F12" CornerRadius="6" Padding="10" Margin="0,0,0,10">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                     Text="This card uses a hand-written script (Script tab), so the blocks below are not used. Choose &quot;Back to blocks&quot; on the Script tab to use them again." />
          <Button Grid.Column="1" Name="TranslateScriptButton" Content="Turn the script into blocks" VerticalAlignment="Center"
                  Command="{Binding TranslateScriptCommand}"
                  ToolTip.Tip="Reads the script effect by effect. When every effect has exact blocks, the card switches to them (the script stays on the Script tab). Nothing is guessed: if any effect has no exact blocks, nothing changes and you're told which." />
        </Grid>
        <SelectableTextBlock IsVisible="{Binding HasTranslationReport}" Text="{Binding TranslationReport}" TextWrapping="Wrap" FontSize="12" Foreground="#E8D9B0" />
      </StackPanel>
    </Border>

    <ScrollViewer>
      <StackPanel>
        <Border IsVisible="{Binding HasNoEffects}" Classes="effect">
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                     Text="No effects yet. Add a new effect, or start from a template such as &quot;Search on summon&quot; or &quot;Draw 2&quot;." />
        </Border>
        <ItemsControl ItemsSource="{Binding Effects}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:EffectViewModel">
              <Border Classes="effect">
                <StackPanel>
                  <!-- header -->
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Border Grid.Column="0" Classes="number">
                      <TextBlock Text="{Binding Number}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBox Grid.Column="1" Text="{Binding Label}" Watermark="Name this effect (shown when it is activated)" />
                    <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{Binding LimitOptions}" SelectedItem="{Binding Limit}"
                              IsVisible="{Binding ShowLimit}" ToolTip.Tip="How often it can be used" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" IsVisible="{Binding ShowSharedGroup}" Margin="8,0,0,0">
                      <TextBlock Text="shared group" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,4,0" />
                      <NumericUpDown Value="{Binding SharedGroup}" Minimum="0" Maximum="16" FormatString="0" Width="56" ShowButtonSpinner="False"
                                     ToolTip.Tip="Effects with the same number share one use per turn (&quot;you can only use 1 of these effects per turn&quot;). 0 = its own." />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                      <Button Classes="icon" Content="↑" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move effect up" />
                      <Button Classes="icon" Content="↓" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move effect down" />
                      <Button Classes="icon" Content="⧉" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate effect" />
                      <Button Classes="icon" Content="🗑" Command="{Binding RemoveCommand}" ToolTip.Tip="Delete effect" />
                    </StackPanel>
                  </Grid>

                  <!-- the sheet: WHEN and IF on the left, COST and DO on the right -->
                  <Grid ColumnDefinitions="*,28,*" Margin="0,10,0,0">
                    <StackPanel Grid.Column="0">
                      <Border Classes="section when">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Classes="badge when"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource WhenIcon}" /><TextBlock Text="WHEN" /></StackPanel></Border>
                            <TextBlock Classes="hint" Text="What starts it" />
                          </StackPanel>
                          <ItemsControl ItemsSource="{Binding Trigger}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="vm:BlockViewModel"><views:BlockView /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Classes="add when" Tag="Trigger" Click="OnAddBlock" Content="+ Choose what starts it" IsVisible="{Binding !HasTrigger}" />
                          <Button Classes="add when" Tag="Trigger" Click="OnAddBlock" Content="Change trigger" IsVisible="{Binding HasTrigger}" />
                          <Button Classes="add when" Click="OnAddAlsoWhen" Content="+ Or when..." IsVisible="{Binding CanAddAlsoWhen}"
                                  ToolTip.Tip="Another trigger that starts the same effect, like &quot;If this card is Normal or Special Summoned, or if this card is Tributed&quot;" />
                        </StackPanel>
                      </Border>
                      <Border Classes="section if">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Classes="badge if"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IfIcon}" /><TextBlock Text="IF" /></StackPanel></Border>
                            <TextBlock Classes="hint" Text="Only when all of these are true" />
                          </StackPanel>
                          <ItemsControl ItemsSource="{Binding Conditions}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="vm:BlockViewModel"><views:BlockView /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Classes="add if" Tag="Condition" Click="OnAddBlock" Content="+ Add condition" />
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <!-- arrow from conditions to actions -->
                    <Path Grid.Column="1" Data="M2 12 H18 M12 6 L18 12 L12 18" Stroke="#4A4E5E" StrokeThickness="2.5"
                          StrokeLineCap="Round" StrokeJoin="Round" Width="20" Height="20" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" />

                    <StackPanel Grid.Column="2">
                      <Border Classes="section cost" IsVisible="{Binding ShowCosts}">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Classes="badge cost"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource CostIcon}" /><TextBlock Text="COST" /></StackPanel></Border>
                            <TextBlock Classes="hint" Text="{Binding CostHint}" />
                          </StackPanel>
                          <ItemsControl ItemsSource="{Binding Costs}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="vm:BlockViewModel"><views:BlockView /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Classes="add cost" Tag="Cost" Click="OnAddBlock" Content="+ Add cost" />
                        </StackPanel>
                      </Border>
                      <Border Classes="section do" IsVisible="{Binding IsProcedure}">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Classes="badge do"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource DoIcon}" /><TextBlock Text="DO" /></StackPanel></Border>
                            <TextBlock Classes="hint" Text="Special Summons this card" />
                          </StackPanel>
                          <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                     Text="A Summon procedure needs no DO blocks: it doesn't start a chain, so it can't be responded to. For something that happens after, add an effect with &quot;If this card is Special Summoned&quot;." />
                        </StackPanel>
                      </Border>
                      <Border Classes="section" Classes.do="{Binding !IsPassive}" Classes.always="{Binding IsPassive}" IsVisible="{Binding !IsProcedure}">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Classes="badge do" IsVisible="{Binding !IsPassive}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource DoIcon}" /><TextBlock Text="DO" /></StackPanel></Border>
                            <Border Classes="badge always" IsVisible="{Binding IsPassive}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AlwaysIcon}" /><TextBlock Text="ALWAYS" /></StackPanel></Border>
                            <TextBlock Classes="hint" Text="What happens, in order" IsVisible="{Binding !IsPassive}" />
                            <TextBlock Classes="hint" Text="Applies the whole time it's face-up" IsVisible="{Binding IsPassive}" />
                          </StackPanel>
                          <ItemsControl ItemsSource="{Binding Actions}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="vm:BlockViewModel"><views:BlockView /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Classes="add do" Tag="Action" Click="OnAddBlock" Content="+ Add action" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>

                  <!-- what it says on the card, and anything wrong -->
                  <Border Background="#14151A" CornerRadius="8" Padding="12,8" BorderBrush="#3A3D4C" BorderThickness="3,0,0,0">
                    <StackPanel>
                      <TextBlock Text="ON THE CARD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2" />
                      <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" FontStyle="Italic" Foreground="#D1D5DB" />
                    </StackPanel>
                  </Border>
                  <TextBlock Text="{Binding Problems}" IsVisible="{Binding HasProblems}" Foreground="{StaticResource ErrorBrush}"
                             TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
