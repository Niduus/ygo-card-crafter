<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CardCrafter.App.ViewModels"
             x:Class="CardCrafter.App.Views.OmegaView"
             x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
    <StackPanel Grid.Row="0">
      <TextBlock Classes="h2" Text="YGO Omega" Margin="0,0,0,4" />
      <TextBlock Text="{Binding OmegaStatus}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="Find Omega again" Command="{Binding DetectOmegaCommand}" />
        <Button Content="Browse…" Command="{Binding BrowseOmegaCommand}" />
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="1">
      <TextBlock Classes="h2" Text="Get your cards into the game" />
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                 Text="Export writes the standard custom-card files: a .cdb database, a script folder with one c&lt;passcode&gt;.lua per card, and a pics folder for artwork. Install copies them into Omega, backing up anything it replaces." />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="Export to folder" Command="{Binding ExportCommand}" />
        <Button Content="Install into Omega" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" />
      </StackPanel>
      <TextBlock Text="{Binding ExportFolder}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
    </StackPanel>

    <TextBlock Grid.Row="2" Classes="h2" Text="What Card Crafter found in your Omega folder" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
      <Button Content="Copy report" Command="{Binding CopyReportCommand}"
              ToolTip.Tip="Share this in Discord if install isn't available for your Omega version" />
    </StackPanel>
    <TextBox Grid.Row="4" Text="{Binding ScanReport, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource CodeFont}"
             FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" />
  </Grid>
</UserControl>
