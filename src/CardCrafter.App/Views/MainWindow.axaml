<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CardCrafter.App.ViewModels"
        xmlns:views="using:CardCrafter.App.Views"
        xmlns:omega="using:CardCrafter.Core.Omega"
        x:Class="CardCrafter.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Icon="avares://YGOCardCrafter/Assets/icon.ico"
        Width="1360" Height="860" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SavePackCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SavePackAsCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenPackCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewPackCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <!-- toolbar -->
    <Border DockPanel.Dock="Top" Background="#15161B" Padding="10,8" BorderBrush="#2A2C36" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <!-- wraps onto a second row in narrow windows instead of running off the edge -->
        <WrapPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,-4">
          <WrapPanel.Styles>
            <Style Selector="WrapPanel > Button, WrapPanel > CheckBox, WrapPanel > Border">
              <Setter Property="Margin" Value="0,0,6,4" />
            </Style>
          </WrapPanel.Styles>
          <Image Source="avares://YGOCardCrafter/Assets/icon.png" Width="26" Height="26" Margin="0,0,12,4" />
          <Button Content="New" Command="{Binding NewPackCommand}" ToolTip.Tip="New pack (Ctrl+N)" />
          <Button Content="Open…" Command="{Binding OpenPackCommand}" ToolTip.Tip="Open a pack (.ycc) or a card database (.db, .cdb) (Ctrl+O)" />
          <Button Content="Open from Omega ▾" IsEnabled="{Binding HasOmegaDatabases}"
                  ToolTip.Tip="Open one of YGO Omega's custom card databases, with its scripts and art">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Spacing="4" MinWidth="260">
                  <TextBlock Text="Custom databases in YGO Omega" FontWeight="SemiBold" Margin="0,0,0,2" />
                  <ScrollViewer MaxHeight="360">
                    <ItemsControl ItemsSource="{Binding OmegaDatabases}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:OmegaDatabaseItem">
                          <Button Content="{Binding Label}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,1"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenOmegaDatabaseCommand}" CommandParameter="{Binding Path}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Content="Save" Command="{Binding SavePackCommand}" ToolTip.Tip="{Binding SaveTip}" />
          <Button Content="Save as ▾">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Card Crafter pack (.ycc)…" Command="{Binding SavePackAsCommand}" InputGesture="Ctrl+Shift+S" />
                <MenuItem Header="Card database (.db / .cdb), with scripts and art…" Command="{Binding SaveAsDatabaseCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Border Width="1" Height="24" Background="#2A2C36" />
          <Button Content="Import cards…" Command="{Binding ImportCdbCommand}" ToolTip.Tip="Add the cards of another database (.db, .cdb) to this pack" />
          <Button Content="Export" Command="{Binding ExportCommand}" ToolTip.Tip="Write the .cdb, scripts and pics to a folder" />
          <Button Content="Install into Omega" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" Classes="accent"
                  ToolTip.Tip="Put the database, scripts and art into YGO Omega's folders" />
          <CheckBox Content="Install on save" IsChecked="{Binding InstallOnSave}" IsEnabled="{Binding CanInstall}" VerticalAlignment="Center"
                    ToolTip.Tip="Every save also installs the database, scripts and art into YGO Omega" />
        </WrapPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <TextBlock Text="{Binding OmegaStatus}" VerticalAlignment="Center" FontSize="12"
                     Foreground="{StaticResource MutedBrush}" MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OmegaStatus}" />
          <Button Content="{Binding VersionText}" Command="{Binding CheckForUpdatesCommand}" FontSize="11" Padding="8,2"
                  ToolTip.Tip="Check GitHub for a newer version" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- update banner -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding ShowUpdateBanner}" Background="#1E3A8A" Padding="12,6">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding UpdateBannerText}" VerticalAlignment="Center" FontWeight="SemiBold" />
          <ProgressBar IsVisible="{Binding IsUpdating}" Value="{Binding UpdateProgress}" Width="160" Minimum="0" Maximum="100" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Content="What's new" Command="{Binding WhatsNewCommand}" />
          <Button Content="Update now" Command="{Binding UpdateNowCommand}" IsEnabled="{Binding !IsUpdating}" Classes="accent" />
          <Button Content="Later" Command="{Binding UpdateLaterCommand}" IsEnabled="{Binding !IsUpdating}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Background="#15161B" Padding="10,4" BorderBrush="#2A2C36" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- pack and card list -->
    <Border DockPanel.Dock="Left" Width="280" Background="#191A20" BorderBrush="#2A2C36" BorderThickness="0,0,1,0" Padding="10">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0">
          <TextBlock Classes="label" Text="Pack name" Margin="0,0,0,2" />
          <TextBox Text="{Binding PackName}" />
          <TextBlock Classes="label" Text="Author" />
          <TextBox Text="{Binding PackAuthor}" Watermark="your name" />
          <TextBlock Classes="label" Text="Card pool in YGO Omega" />
          <ComboBox ItemsSource="{Binding PoolOptions}" SelectedItem="{Binding PackPool}" HorizontalAlignment="Stretch"
                    ToolTip.Tip="Omega's deck editor lists cards by card pool. Custom cards belong in Custom (Filter → Card Pool → Custom)." />
          <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,4">
            <TextBlock Text="Cards" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
              <Button Classes="icon" Content="+" ToolTip.Tip="Add a card">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="Monster" Command="{Binding AddCardCommand}" CommandParameter="Monster" />
                    <MenuItem Header="Spell" Command="{Binding AddCardCommand}" CommandParameter="Spell" />
                    <MenuItem Header="Trap" Command="{Binding AddCardCommand}" CommandParameter="Trap" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Classes="icon" Content="⧉" Command="{Binding DuplicateCardCommand}" ToolTip.Tip="Duplicate card" />
              <Button Classes="icon" Content="🗑" Command="{Binding DeleteCardCommand}" ToolTip.Tip="Delete card" />
            </StackPanel>
          </Grid>
        </StackPanel>
        <ListBox Grid.Row="1" MinHeight="120" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:CardViewModel">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding ListLabel}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ListDetail}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- Archetypes and Types scroll on their own, so the card list always keeps its space -->
        <ScrollViewer Grid.Row="2" MaxHeight="460" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
        <Expander Header="Archetypes" Margin="0,0,0,0" HorizontalAlignment="Stretch">
          <StackPanel Spacing="4">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       Text="An archetype is a name shared by a group of cards. Each needs a code from 0x1 to 0xffff that other packs don't use." />
            <ItemsControl ItemsSource="{Binding Archetypes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ArchetypeViewModel">
                  <Grid ColumnDefinitions="*,4,80,Auto" RowDefinitions="Auto,Auto" Margin="0,2">
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Warning}" IsVisible="{Binding HasWarning}"
                               TextWrapping="Wrap" FontSize="11" Foreground="#FCD34D" Margin="0,2,0,0" />
                    <TextBox Grid.Column="0" Text="{Binding Name}" />
                    <TextBox Grid.Column="2" Text="{Binding Code}" FontFamily="{StaticResource CodeFont}" />
                    <Button Grid.Column="3" Classes="icon" Content="✕"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveArchetypeCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="4">
              <Button Content="+ New archetype" Command="{Binding AddArchetypeCommand}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="A new archetype with a code nothing in Omega uses" />
              <Button Content="Use one from Omega…" IsEnabled="{Binding HasCatalog}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Make your cards part of an archetype that already exists in the game">
                <Button.Flyout>
                  <Flyout Placement="RightEdgeAlignedBottom">
                    <StackPanel Width="340" Spacing="6">
                      <TextBox Text="{Binding ArchetypeSearch}" Watermark="Search, e.g. HERO or Blue-Eyes" />
                      <ListBox ItemsSource="{Binding KnownArchetypes}" Height="320">
                        <ListBox.ItemTemplate>
                          <DataTemplate DataType="omega:KnownArchetype">
                            <Button Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).UseKnownArchetypeCommand}" CommandParameter="{Binding}">
                              <StackPanel>
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Text="{Binding Examples[0]}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </StackPanel>
        </Expander>
        <Expander Header="Custom Types" Margin="0,6,0,0" HorizontalAlignment="Stretch">
          <StackPanel Spacing="4">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       Text="Monster Types beyond the standard ones. The value must match what YGO Omega uses for that Type." />
            <ItemsControl ItemsSource="{Binding CustomTypes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:CustomTypeViewModel">
                  <Grid ColumnDefinitions="*,4,96,Auto" Margin="0,2">
                    <TextBox Grid.Column="0" Text="{Binding Name}" />
                    <TextBox Grid.Column="2" Text="{Binding Value}" FontFamily="{StaticResource CodeFont}" />
                    <Button Grid.Column="3" Classes="icon" Content="✕"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveCustomTypeCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Add custom Type" Command="{Binding AddCustomTypeCommand}" HorizontalAlignment="Stretch" />
            <StackPanel IsVisible="{Binding HasFoundTypes}" Spacing="2">
              <TextBlock Classes="label" Text="Types found in your Omega (click to add)" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding FoundTypes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="omega:UnknownType">
                    <Button Classes="chip" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).UseFoundTypeCommand}" CommandParameter="{Binding}">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- editor -->
    <TabControl Margin="12,6,12,0" x:Name="Tabs">
      <TabItem Header="Card">
        <Panel>
          <Panel IsVisible="{Binding HasSelection}"><views:CardFormView DataContext="{Binding SelectedCard}" /></Panel>
          <TextBlock Text="Add a card with the + button on the left." IsVisible="{Binding !HasSelection}" Margin="0,20" />
        </Panel>
      </TabItem>
      <TabItem Header="Effects">
        <Panel>
          <Panel IsVisible="{Binding HasSelection}"><views:EffectSheetView DataContext="{Binding SelectedCard}" /></Panel>
          <TextBlock Text="Add a card with the + button on the left." IsVisible="{Binding !HasSelection}" Margin="0,20" />
        </Panel>
      </TabItem>
      <TabItem Header="Script">
        <Panel>
          <Panel IsVisible="{Binding HasSelection}"><views:ScriptView DataContext="{Binding SelectedCard}" /></Panel>
        </Panel>
      </TabItem>
      <TabItem Header="Omega">
        <views:OmegaView />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
